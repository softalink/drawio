			"width": 160,
			"height": 90
		}
	],
	"paths": {
		"path1": "M0 0 L40 0 L40 40 L0 40 Z"
	},
	"networks": [
		{
			"name": "plc",
			"protocol": "mqtt",
			"url": "mqtt://broker.local:1883",
			"topics": "plant/tank,plant/pump",
			"options": { "clientId": "hmi-1" }
		},
		{
			"name": "rest",
			"protocol": "http",
			"url": "http://api.local/status",
			"method": "GET",
			"interval": 2000
		},
		{
			"name": "legacyIot",
			"protocol": "iot",
			"url": "iot://gateway"
		}
	],
	"http": "http://legacy.local/status",
	"httpTimeInterval": 5000,
	"realTimes": [
		{
			"label": "Pump Speed",
			"key": "text",
			"type": "float",
			"bind": { "id": "pump" },
			"enableMock": true,
			"mock": "0-100",
			"triggers": [
				{
					"name": "highSpeed",
					"conditions": [{ "key": "value", "operator": ">", "value": 80 }],
					"actions": [
						{ "action": 1, "value": { "background": "#ff0000" }, "params": "self" }
					]
				}
			]
		},
		{
			"label": "Pump Running",
			"key": "progress",
			"type": "bool",
			"bind": { "id": "pump" }
		}
	],
	"triggers": [
		{
			"name": "globalHighTemp",
			"conditions": [{ "key": "tank.temp", "operator": ">=", "value": 90 }],
			"actions": [
				{ "action": 18, "value": "High temperature" }
			]
		}
	]
}
