			"x": 160,
			"y": 130,
			"fromArrow": "none",
			"toArrow": "triangle",
			"lineWidth": 2,
			"color": "#555555",
			"lineAnimateType": 0,
			"animateSpan": 20,
			"animateReverse": true,
			"animateColor": "#ff0000",
			"autoPlay": true,
			"anchors": [
				{ "x": 0, "y": 0 },
				{ "x": 100, "y": -20 }
			]
		},
		{
			"id": "grp1",
			"name": "combine",
