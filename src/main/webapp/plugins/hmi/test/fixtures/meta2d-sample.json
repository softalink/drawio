			"y": 200,
			"width": 120,
			"height": 80,
			"children": ["c1", "c2"]
		},
		{
			"id": "c1",
			"name": "rectangle",
			"parentId": "grp1",
			"x": 610,
			"y": 210,
			"width": 40,
			"height": 30,
			"text": "A"
		},
		{
			"id": "c2",
