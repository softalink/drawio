{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawio.example/hmi/doc.schema.json",
  "title": "HMI document config",
  "description": "Attribute `hmi` on the model root cell (id 0) of each page. See plugins/hmi/ARCHITECTURE.md §2.1.",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "default": 1 },
    "sources": { "type": "array", "items": { "$ref": "source.schema.json" }, "default": [] },
    "tags": { "type": "array", "items": { "$ref": "tag.schema.json" }, "default": [] },
    "triggers": { "type": "array", "items": { "$ref": "triggers.schema.json/$defs/trigger" }, "default": [] },
    "sim": { "enum": ["off", "on", "only"], "default": "off" },
    "runtime": {
      "type": "object",
      "properties": {
        "fit": { "enum": ["none", "page", "width", "stretch"], "default": "page" },
        "panZoom": { "type": "boolean", "default": true },
        "nav": { "enum": ["tabs", "none"], "default": "tabs" },
        "maxRate": { "type": "number", "default": 30 },
        "quality": { "enum": ["outline", "none"], "default": "outline" },
        "theme": { "enum": ["default", "isa101"], "default": "default" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "hoverHalo": {
          "description": "Hover glow of interactive objects: false, or {color, size, pressColor, pressSize, press}.",
          "type": ["boolean", "object"]
        },
        "blink": {
          "type": "object",
          "description": "Blink half-periods in ms for InTouch blink links (INTOUCH_LINKS.md §7).",
          "properties": {
            "slow": { "type": "number", "default": 1000 },
            "medium": { "type": "number", "default": 500 },
            "fast": { "type": "number", "default": 250 }
          }
        }
      },
      "additionalProperties": true
    },
    "scripts": { "enum": ["inherit", "off"], "default": "inherit" },
    "window": {
      "type": "object",
      "description": "InTouch window type of this page (INTOUCH_LINKS.md §8).",
      "properties": {
        "type": { "enum": ["replace", "overlay", "popup"], "default": "replace" },
        "x": { "type": ["number", "null"] },
        "y": { "type": ["number", "null"] },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "title": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
