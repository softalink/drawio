{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drawio.example/hmi/doc.schema.json",
  "title": "HMI document config",
  "description": "Attribute `hmi` on the model root cell (id 0) of each page. See plugins/hmi/ARCHITECTURE.md §2.1.",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "default": 1 },
    "sources": { "type": "array", "items": { "$ref": "source.schema.json" }, "default": [] },
    "tags": { "type": "array", "items": { "$ref": "tag.schema.json" }, "default": [] },
    "triggers": { "type": "array", "items": { "$ref": "triggers.schema.json/$defs/trigger" }, "default": [] },
    "sim": { "enum": ["off", "on", "only"], "default": "off" },
    "runtime": {
      "type": "object",
      "properties": {
        "fit": { "enum": ["none", "page", "width", "stretch"], "default": "page" },
        "panZoom": { "type": "boolean", "default": true },
        "nav": { "enum": ["tabs", "none"], "default": "tabs" },
        "maxRate": { "type": "number", "default": 30 },
        "quality": { "enum": ["outline", "none"], "default": "outline" },
        "theme": { "enum": ["default", "isa101"], "default": "default" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "hoverHalo": {
          "description": "Hover halo of interactive objects: false (off) or settings (see runtime/HmiHalo.js).",
          "type": ["boolean", "object"],
          "properties": {
            "preset": { "enum": ["softGlow", "subtleGlow", "strongGlow", "crispOutline", "shapeOutline", "dashedOutline", "glowOutline"] },
            "style": { "enum": ["glow", "outline", "glowOutline"], "default": "glow" },
            "outlineShape": { "enum": ["rect", "shape"], "default": "rect" },
            "color": { "type": "string", "default": "#1E88E5" },
            "size": { "type": "number", "minimum": 1, "maximum": 40, "default": 6 },
            "intensity": { "type": "number", "minimum": 10, "maximum": 100, "default": 100 },
            "width": { "type": "number", "minimum": 1, "maximum": 8, "default": 2 },
            "padding": { "type": "number", "minimum": 0, "maximum": 20, "default": 3 },
            "radius": { "type": "number", "minimum": 0, "maximum": 20, "default": 4 },
            "dashed": { "type": "boolean", "default": false },
            "press": { "type": "boolean", "default": true },
            "pressColor": { "type": ["string", "null"] },
            "pressSize": { "type": ["number", "null"] }
          }
        },
        "blink": {
          "type": "object",
          "description": "Blink half-periods in ms for InTouch blink links (INTOUCH_LINKS.md §7).",
          "properties": {
            "slow": { "type": "number", "default": 1000 },
            "medium": { "type": "number", "default": 500 },
            "fast": { "type": "number", "default": 250 }
          }
        }
      },
      "additionalProperties": true
    },
    "scripts": { "enum": ["inherit", "off"], "default": "inherit" },
    "window": {
      "type": "object",
      "description": "InTouch window type of this page (INTOUCH_LINKS.md §8).",
      "properties": {
        "type": { "enum": ["replace", "overlay", "popup"], "default": "replace" },
        "x": { "type": ["number", "null"] },
        "y": { "type": ["number", "null"] },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "title": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
